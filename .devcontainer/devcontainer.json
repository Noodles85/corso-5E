{
  "name": "PHP & MariaDB",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [80, 3306],
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          ".devcontainer": true
        }
      },
    "extensions": [
      "cweijan.vscode-mysql-client2"
      ]
    }
  }
}
